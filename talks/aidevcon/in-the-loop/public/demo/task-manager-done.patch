+import type { Task, TaskFilter, TaskStatus } from '../types.ts'
+
+export function filterTasks(tasks: readonly Task[], filter: TaskFilter = {}): Task[] {
+  const statuses = filter.status === undefined
+    ? undefined
+    : Array.isArray(filter.status) ? filter.status : [filter.status]
+  const assignee = filter.assignee?.replace(/^@/, '')
+
+  return tasks.filter((task) => {
+    if (statuses && !statuses.includes(task.status)) return false
+    if (assignee !== undefined && !task.assignees.some((name) => name.replace(/^@/, '') === assignee)) return false
+    if (filter.label !== undefined && !task.labels.includes(filter.label)) return false
+    if (filter.priority !== undefined && task.priority !== filter.priority) return false
+    return true
+  })
+}
+
+export function groupTasksByStatus(tasks: readonly Task[]): Record<TaskStatus, Task[]> {
+  const groups: Record<TaskStatus, Task[]> = {
+    'To Do': [],
+    'In Progress': [],
+    'Done': [],
+  }
+
+  for (const task of tasks) groups[task.status].push(task)
+  return groups
+}
