@@ -0,0 +1,27 @@
+import type { BoardColumn } from '../types.ts'
+import { ansi, colourForStatus, padVisible } from './ansi-theme.ts'
+import { drawBox } from './box-frame.ts'
+import { renderTaskCard } from './card-renderer.ts'
+
+export function renderColumnsSideBySide(
+  columns: readonly BoardColumn[],
+  columnWidth = 36,
+  maxCardsPerColumn = 6,
+): string {
+  const width = Math.max(2, Math.floor(columnWidth))
+  const limit = Math.max(0, Math.floor(maxCardsPerColumn))
+  const contents = columns.map(col => {
+    const lines = col.tasks.slice(0, limit).flatMap(task => renderTaskCard(task, width - 2))
+    const remaining = col.tasks.length - Math.min(col.tasks.length, limit)
+    if (remaining > 0) lines.push(ansi.dim(`+${remaining} more tasks...`))
+    return lines
+  })
+  const height = Math.max(0, ...contents.map(lines => lines.length))
+  const boxes = columns.map((col, index) => {
+    const lines = contents[index].concat(Array(height - contents[index].length).fill(''))
+    return drawBox(lines, width, `${col.title} (${col.tasks.length})`, colourForStatus(col.status))
+  })
+
+  if (boxes.length === 0) return ''
+  return boxes[0].map((_, row) => boxes.map(box => padVisible(box[row], width)).join('  ')).join('\n')
+}
