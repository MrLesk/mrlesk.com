@@ -0,0 +1,63 @@
+import { normalizeStatus } from '../model/status-config.ts'
+
+type FrontmatterValue = string | string[]
+
+function unquote(value: string): string {
+  const trimmed = value.trim()
+  if (trimmed.length >= 2 && trimmed.startsWith('"') && trimmed.endsWith('"')) {
+    try {
+      return JSON.parse(trimmed) as string
+    } catch {
+      return trimmed.slice(1, -1)
+    }
+  }
+  if (trimmed.length >= 2 && trimmed.startsWith("'") && trimmed.endsWith("'")) {
+    return trimmed.slice(1, -1).replace(/''/g, "'")
+  }
+  return trimmed
+}
+
+export function parseFrontmatter(raw: string): {
+  attributes: Record<string, string | string[]>
+  body: string
+} {
+  const match = /^(?:\uFEFF)?---[\t ]*\r?\n([\s\S]*?)^---[\t ]*(?:\r?\n|$)/m.exec(raw)
+  if (!match) return { attributes: {}, body: raw }
+
+  const attributes: Record<string, FrontmatterValue> = {}
+  let currentKey: string | undefined
+  for (const line of match[1].split(/\r?\n/)) {
+    const item = /^\s+-\s*(.*)$/.exec(line)
+    if (item && currentKey) {
+      if (!Array.isArray(attributes[currentKey])) attributes[currentKey] = []
+      ;(attributes[currentKey] as string[]).push(unquote(item[1]))
+      continue
+    }
+    const field = /^([^\s:#][^:]*):(?:\s*(.*))?$/.exec(line)
+    if (!field) {
+      currentKey = undefined
+      continue
+    }
+    currentKey = field[1].trim()
+    const value = (field[2] ?? '').trim()
+    if (value.startsWith('[') && value.endsWith(']')) {
+      const contents = value.slice(1, -1).trim()
+      attributes[currentKey] = contents
+        ? (contents.match(/"(?:\\.|[^"\\])*"|'(?:''|[^'])*'|[^,]+/g) ?? []).map(unquote)
+        : []
+    } else {
+      const scalar = unquote(value)
+      attributes[currentKey] = currentKey === 'status' ? normalizeStatus(scalar) : scalar
+    }
+  }
+  return { attributes, body: raw.slice(match[0].length) }
+}
+
+export function asString(value: string | string[] | undefined, fallback = ''): string {
+  return typeof value === 'string' ? value : value?.[0] ?? fallback
+}
+
+export function asStringArray(value: string | string[] | undefined): string[] {
+  if (Array.isArray(value)) return value
+  return value ? [value] : []
+}
