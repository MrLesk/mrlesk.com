@@ -0,0 +1,26 @@
+import { ansi, padVisible, visibleLength } from './ansi-theme.ts'
+
+export function horizontalRule(width: number, char = '─'): string {
+  return char.repeat(Math.max(0, Math.floor(width)))
+}
+
+export function drawBox(
+  lines: readonly string[],
+  width: number,
+  title?: string,
+  borderColour: (s: string) => string = ansi.gray,
+): string[] {
+  const innerWidth = Math.max(0, Math.floor(width) - 2)
+  let top = horizontalRule(innerWidth)
+
+  if (title && innerWidth > 0) {
+    const label = padVisible(` ${title} `, Math.min(innerWidth, visibleLength(` ${title} `)))
+    top = label + horizontalRule(innerWidth - visibleLength(label))
+  }
+
+  return [
+    borderColour(`╭${top}╮`),
+    ...lines.map(line => borderColour('│') + padVisible(line, innerWidth) + borderColour('│')),
+    borderColour(`╰${horizontalRule(innerWidth)}╯`),
+  ]
+}
