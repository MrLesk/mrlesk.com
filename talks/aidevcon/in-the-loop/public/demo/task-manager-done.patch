+import type { BoardColumn, KanbanOptions, Task } from '../types.ts'
+import { DEFAULT_COLUMNS } from '../model/status-config.ts'
+import { filterTasks, groupTasksByStatus } from '../query/task-filter.ts'
+import { computeBoardMetrics } from '../query/board-metrics.ts'
+import { loadTasksFromDirectory } from '../store/task-store.ts'
+import { renderBoardHeader } from '../ui/board-header.ts'
+import { renderColumnsSideBySide } from '../ui/column-layout.ts'
+
+export function renderKanbanBoard(tasks: readonly Task[], options?: KanbanOptions): string {
+  const visibleTasks = options?.filter ? filterTasks(tasks, options.filter) : tasks
+  const metrics = computeBoardMetrics(visibleTasks)
+  const groups = groupTasksByStatus(visibleTasks)
+  const columns: BoardColumn[] = DEFAULT_COLUMNS.map(column => ({
+    ...column,
+    tasks: groups[column.status],
+  }))
+  const columnWidth = Math.max(2, Math.floor(options?.columnWidth ?? 36))
+  const header = renderBoardHeader(options?.projectName ?? 'Task Manager', metrics, columnWidth * columns.length + 2 * (columns.length - 1))
+  const board = renderColumnsSideBySide(columns, columnWidth, options?.maxCardsPerColumn)
+  return `${header}\n${board}`
+}
+
+export async function runKanbanCommand(tasksDir: string, options?: KanbanOptions): Promise<string> {
+  const tasks = await loadTasksFromDirectory(tasksDir)
+  return renderKanbanBoard(tasks, options)
+}
