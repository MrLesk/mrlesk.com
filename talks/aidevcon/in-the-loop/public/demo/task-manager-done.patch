+import type { AcceptanceCriterion } from '../types.ts'
+
+export function parseMarkdownBody(body: string): {
+  description: string
+  criteria: AcceptanceCriterion[]
+} {
+  const lines = body.split(/\r?\n/)
+  const descriptionHeading = lines.findIndex((line) => /^\s*##\s+Description\s*#*\s*$/i.test(line))
+  const start = descriptionHeading === -1 ? 0 : descriptionHeading + 1
+  let end = start
+  while (end < lines.length && !/^\s*##\s+/.test(lines[end])) end++
+
+  const criteria: AcceptanceCriterion[] = []
+  for (const line of lines) {
+    const match = line.match(/^\s*-\s+\[([ xX])\]\s*(.*)$/)
+    if (match) {
+      criteria.push({
+        index: criteria.length + 1,
+        text: match[2].trim(),
+        checked: match[1].toLowerCase() === 'x',
+      })
+    }
+  }
+
+  return { description: lines.slice(start, end).join('\n').trim(), criteria }
+}
