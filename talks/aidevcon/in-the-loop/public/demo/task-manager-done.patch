+import type { TaskStatus } from '../types.ts'
+import { parseFrontmatter } from './frontmatter-parser.ts'
+
+export function updateTaskStatusInMarkdown(
+  content: string,
+  newStatus: TaskStatus,
+  assignee?: string,
+): string {
+  const parsed = parseFrontmatter(content)
+  const match = /^(?:\uFEFF)?---[\t ]*\r?\n([\s\S]*?)^---[\t ]*(?:\r?\n|$)/m.exec(content)
+  if (!match || match.index !== 0 || content.slice(match[0].length) !== parsed.body) {
+    throw new Error('Markdown content does not contain valid frontmatter')
+  }
+
+  const newline = match[0].includes('\r\n') ? '\r\n' : '\n'
+  let frontmatter = match[1]
+  const statusLine = /^status:[^\r\n]*/m
+  if (statusLine.test(frontmatter)) {
+    frontmatter = frontmatter.replace(statusLine, `status: ${JSON.stringify(newStatus)}`)
+  } else {
+    frontmatter += `status: ${JSON.stringify(newStatus)}${newline}`
+  }
+
+  if (assignee !== undefined) {
+    const assigneeBlock = /^assignee:[^\r\n]*(?:\r?\n[\t ]+[^\r\n]*)*/m
+    const replacement = `assignee:${newline}  - ${JSON.stringify(assignee)}`
+    if (assigneeBlock.test(frontmatter)) {
+      frontmatter = frontmatter.replace(assigneeBlock, () => replacement)
+    } else {
+      frontmatter += `${replacement}${newline}`
+    }
+  }
+
+  const openingLength = match[0].indexOf(match[1])
+  const closingStart = openingLength + match[1].length
+  return match[0].slice(0, openingLength) + frontmatter + match[0].slice(closingStart) + parsed.body
+}
