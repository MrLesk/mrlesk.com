+import { normalizeStatus } from '../model/status-config.ts'
+import { loadTasksFromDirectory, saveTaskStatus } from '../store/task-store.ts'
+import { getReadyTasks } from '../query/ready-resolver.ts'
+
+export async function runMoveCommand(
+  tasksDir: string,
+  taskId: string,
+  rawStatus: string,
+  assignee?: string,
+): Promise<string> {
+  const status = normalizeStatus(rawStatus)
+  const task = await saveTaskStatus(tasksDir, taskId, status, assignee)
+  if (!task) throw new Error(`Task not found: ${taskId}`)
+
+  const tasks = await loadTasksFromDirectory(tasksDir)
+  const readyCount = getReadyTasks(tasks).length
+  return `Moved ${task.id} to ${status}. ${readyCount} tasks are now ready.`
+}
