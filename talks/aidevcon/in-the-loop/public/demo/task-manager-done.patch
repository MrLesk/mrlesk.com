+import { readFile, readdir, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import type { Task, TaskStatus } from '../types.ts'
+import { parseTaskFile } from '../parser/task-loader.ts'
+import { updateTaskStatusInMarkdown } from '../parser/task-serializer.ts'
+
+export async function loadTasksFromDirectory(dirPath: string): Promise<Task[]> {
+  const entries = await readdir(dirPath, { withFileTypes: true })
+  const tasks = await Promise.all(
+    entries.filter(entry => entry.isFile() && entry.name.endsWith('.md')).map(async entry => {
+      const filePath = join(dirPath, entry.name)
+      return parseTaskFile(filePath, await readFile(filePath, 'utf8'))
+    }),
+  )
+  return tasks.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }))
+}
+
+export async function saveTaskStatus(
+  dirPath: string,
+  taskId: string,
+  status: TaskStatus,
+  assignee?: string,
+): Promise<Task | undefined> {
+  const tasks = await loadTasksFromDirectory(dirPath)
+  const task = tasks.find(item => item.id.toLowerCase() === taskId.toLowerCase())
+  if (!task) return undefined
+
+  const content = await readFile(task.filePath, 'utf8')
+  const updated = updateTaskStatusInMarkdown(content, status, assignee)
+  await writeFile(task.filePath, updated, 'utf8')
+  return parseTaskFile(task.filePath, updated)
+}
