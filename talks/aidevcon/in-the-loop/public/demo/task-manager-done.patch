+import { loadTasksFromDirectory } from '../store/task-store.ts'
+import { getReadyTasks } from '../query/ready-resolver.ts'
+import { searchTasks } from '../query/task-search.ts'
+
+export async function runListCommand(
+  tasksDir: string,
+  options?: { ready?: boolean; search?: string },
+): Promise<string> {
+  let tasks = await loadTasksFromDirectory(tasksDir)
+  if (options?.ready) tasks = getReadyTasks(tasks)
+  if (options?.search?.trim()) tasks = searchTasks(tasks, options.search)
+
+  return tasks.map((task) => {
+    const checked = task.criteria.filter((criterion) => criterion.checked).length
+    return `${task.id}  [${task.status}]  ${task.title} (ac: ${checked}/${task.criteria.length})`
+  }).join('\n')
+}
