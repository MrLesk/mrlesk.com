+import type { Task, TaskFilter } from '../types.ts'
+import { filterTasks } from './task-filter.ts'
+
+export function searchTasks(tasks: readonly Task[], query: string, filter?: TaskFilter): Task[] {
+  const candidates = filter ? filterTasks(tasks, filter) : tasks
+  const tokens = query.toLowerCase().trim().split(/\s+/).filter(Boolean)
+
+  return candidates.filter((task) => {
+    const fields = [task.id, task.title, task.description, ...task.labels].map((field) => field.toLowerCase())
+    return tokens.every((token) => fields.some((field) => field.includes(token)))
+  })
+}
