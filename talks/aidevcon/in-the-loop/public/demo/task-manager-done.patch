+import type { Task } from '../types.ts'
+import { isTerminalStatus } from '../model/status-config.ts'
+
+export function unmetDependencies(task: Task, allTasks: readonly Task[]): string[] {
+  return task.dependencies.filter((id) => {
+    const dependency = allTasks.find((candidate) => candidate.id === id)
+    return !dependency || !isTerminalStatus(dependency.status)
+  })
+}
+
+export function isTaskReady(task: Task, allTasks: readonly Task[]): boolean {
+  return task.status === 'To Do' && unmetDependencies(task, allTasks).length === 0
+}
+
+export function getReadyTasks(tasks: readonly Task[]): Task[] {
+  return tasks.filter((task) => isTaskReady(task, tasks))
+}
