+import type { Task } from '../types.ts'
+import { ansi, colourForStatus, padVisible } from './ansi-theme.ts'
+import { formatTaskId, formatPriority, formatAssignees, formatCriteriaBar } from './badge-format.ts'
+
+export function renderTaskCard(task: Task, width: number): string[] {
+  const innerWidth = Math.max(0, Math.floor(width) - 2)
+  const border = (left: string, right: string) => ansi.dim(left + '─'.repeat(innerWidth) + right)
+  const row = (content: string) => ansi.dim('│') + padVisible(content, innerWidth) + ansi.dim('│')
+  const heading = [
+    colourForStatus(task.status)(formatTaskId(task.id)),
+    formatPriority(task.priority),
+    formatAssignees(task.assignees),
+  ].filter(Boolean).join(' ')
+  const details = task.dependencies.length > 0
+    ? `deps: ${task.dependencies.join(', ')}`
+    : task.labels.join(', ')
+  const progress = formatCriteriaBar(task.criteria)
+
+  return [
+    border('┌', '┐'),
+    row(heading),
+    row(task.title),
+    row([details, progress].filter(Boolean).join(' ')),
+    border('└', '┘'),
+  ]
+}
