+import type { TaskStatus } from '../types.ts'
+import { STATUS_COLOURS } from '../model/status-config.ts'
+
+const style = (open: number, close: number) => (text: string): string =>
+  `\x1b[${open}m${text}\x1b[${close}m`
+
+export const ansi = {
+  bold: style(1, 22),
+  dim: style(2, 22),
+  cyan: style(36, 39),
+  green: style(32, 39),
+  yellow: style(33, 39),
+  magenta: style(35, 39),
+  red: style(31, 39),
+  gray: style(90, 39),
+  blue: style(34, 39),
+}
+
+export function colourForStatus(status: TaskStatus): (text: string) => string {
+  return ansi[STATUS_COLOURS[status]]
+}
+
+const ansiPattern = /\x1b\[[0-?]*[ -/]*[@-~]/g
+
+export function stripAnsi(text: string): string {
+  return text.replace(ansiPattern, '')
+}
+
+export function visibleLength(text: string): number {
+  return Array.from(stripAnsi(text)).length
+}
+
+export function padVisible(text: string, width: number): string {
+  const target = Math.max(0, Math.floor(width))
+  const length = visibleLength(text)
+  if (length <= target) return text + ' '.repeat(target - length)
+  if (target === 0) return ''
+
+  const limit = target - 1
+  let result = ''
+  let count = 0
+  const tokens = text.match(/\x1b\[[0-?]*[ -/]*[@-~]|[\s\S]/gu) ?? []
+  for (const token of tokens) {
+    if (token.startsWith('\x1b[')) {
+      result += token
+    } else if (count < limit) {
+      result += token
+      count++
+    } else {
+      break
+    }
+  }
+  return result + '…\x1b[0m'
+}
