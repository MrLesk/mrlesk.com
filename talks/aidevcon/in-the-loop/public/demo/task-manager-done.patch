+import type { BoardMetrics } from '../types.ts'
+import { ansi } from './ansi-theme.ts'
+import { drawBox } from './box-frame.ts'
+
+export function renderBoardHeader(projectName: string, metrics: BoardMetrics, width = 112): string {
+  const percent = Math.max(0, Math.min(100, metrics.completionPercent))
+  const barWidth = Math.max(0, Math.min(30, Math.floor(width) - 20))
+  const filled = Math.round(barWidth * percent / 100)
+  const bar = ansi.green('█'.repeat(filled)) + ansi.gray('░'.repeat(barWidth - filled))
+
+  return drawBox([
+    ` ${ansi.bold(projectName)}`,
+    ` ${bar} ${ansi.bold(`${metrics.completionPercent}%`)} complete`,
+    ` Total: ${metrics.total}  Ready: ${metrics.ready}  Blocked: ${metrics.blocked}  In Progress: ${metrics.inProgress}  Done: ${metrics.done}`,
+    ` Criteria: ${metrics.criteriaChecked}/${metrics.criteriaTotal}`,
+  ], width, undefined, ansi.cyan).join('\n')
+}
