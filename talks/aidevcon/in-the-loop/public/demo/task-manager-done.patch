+import type { TaskStatus, BoardColumn } from '../types.ts'
+
+export const STATUS_ORDER: readonly TaskStatus[] = ['To Do', 'In Progress', 'Done']
+
+export const STATUS_COLOURS: Record<TaskStatus, 'yellow' | 'cyan' | 'green'> = {
+  'To Do': 'yellow',
+  'In Progress': 'cyan',
+  Done: 'green',
+}
+
+export const DEFAULT_COLUMNS: readonly Omit<BoardColumn, 'tasks'>[] = STATUS_ORDER.map(
+  status => ({ status, title: status, colour: STATUS_COLOURS[status] }),
+)
+
+export function normalizeStatus(raw: string): TaskStatus {
+  switch (raw.trim().toLowerCase()) {
+    case 'in progress':
+    case 'doing':
+    case 'working':
+      return 'In Progress'
+    case 'done':
+    case 'completed':
+    case 'closed':
+      return 'Done'
+    default:
+      return 'To Do'
+  }
+}
+
+export function isTerminalStatus(status: TaskStatus): boolean {
+  return status === 'Done'
+}
