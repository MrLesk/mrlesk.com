+import type { BoardMetrics, Task } from '../types.ts'
+import { groupTasksByStatus } from './task-filter.ts'
+import { isTaskReady } from './ready-resolver.ts'
+
+export function computeBoardMetrics(tasks: readonly Task[]): BoardMetrics {
+  const groups = groupTasksByStatus(tasks)
+  const total = tasks.length
+  const todo = groups['To Do'].length
+  const inProgress = groups['In Progress'].length
+  const done = groups['Done'].length
+  const ready = tasks.filter((task) => isTaskReady(task, tasks)).length
+  let criteriaChecked = 0
+  let criteriaTotal = 0
+
+  for (const task of tasks) {
+    criteriaTotal += task.criteria.length
+    criteriaChecked += task.criteria.filter((criterion) => criterion.checked).length
+  }
+
+  return {
+    total,
+    todo,
+    inProgress,
+    done,
+    ready,
+    blocked: todo - ready,
+    completionPercent: total === 0 ? 0 : Math.round((done / total) * 100),
+    criteriaChecked,
+    criteriaTotal,
+  }
+}
