+import type { AcceptanceCriterion, TaskPriority } from '../types.ts'
+
+export function formatTaskId(id: string): string {
+  return id.toUpperCase()
+}
+
+export function formatPriority(priority?: TaskPriority): string {
+  switch (priority) {
+    case 'high': return '[HIGH]'
+    case 'medium': return '[MED]'
+    case 'low': return '[LOW]'
+    default: return ''
+  }
+}
+
+export function formatAssignees(assignees: readonly string[]): string {
+  return assignees.map(name => name.startsWith('@') ? name : `@${name}`).join(' ')
+}
+
+export function formatCriteriaBar(criteria: readonly AcceptanceCriterion[], width = 8): string {
+  if (criteria.length === 0) return 'no ac'
+
+  const checked = criteria.filter(criterion => criterion.checked).length
+  const barWidth = Math.max(0, Math.floor(width))
+  const filled = Math.round((checked / criteria.length) * barWidth)
+  return `${'■'.repeat(filled)}${'□'.repeat(barWidth - filled)} ${checked}/${criteria.length}`
+}
