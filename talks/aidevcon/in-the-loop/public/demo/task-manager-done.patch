+import type { Task, TaskPriority } from '../types.ts'
+import { normalizeStatus } from '../model/status-config.ts'
+import { parseFrontmatter, asString, asStringArray } from './frontmatter-parser.ts'
+import { parseMarkdownBody } from './markdown-body.ts'
+
+export function parseTaskFile(filePath: string, content: string): Task {
+  const { attributes, body } = parseFrontmatter(content)
+  const { description, criteria } = parseMarkdownBody(body)
+  const filename = filePath.split(/[\\/]/).pop() ?? ''
+  const filenameId = filename.match(/^(task-\d+(?:\.\d+)*)/i)?.[1] ?? ''
+  const rawPriority = asString(attributes.priority).trim().toLowerCase()
+  const priority: TaskPriority | undefined =
+    rawPriority === 'high' || rawPriority === 'medium' || rawPriority === 'low'
+      ? rawPriority
+      : undefined
+
+  return {
+    id: asString(attributes.id, filenameId),
+    title: asString(attributes.title),
+    status: normalizeStatus(asString(attributes.status)),
+    priority,
+    assignees: asStringArray(attributes.assignee ?? attributes.assignees),
+    labels: asStringArray(attributes.labels),
+    dependencies: asStringArray(attributes.dependencies),
+    references: asStringArray(attributes.references),
+    description,
+    criteria,
+    filePath,
+  }
+}
